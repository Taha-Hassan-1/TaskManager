  "components": {
    "schemas": {
      "ActivityDto": {
        "required": [
          "id",
          "type",
          "actorId",
          "actorName",
          "taskItemId",
          "payload",
          "createdAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "type": {
            "$ref": "#/components/schemas/ActivityType"
          },
          "actorId": {
            "type": "integer",
            "format": "int32"
          },
          "actorName": {
            "type": "string"
          },
          "taskItemId": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "payload": {
            "$ref": "#/components/schemas/JsonElement"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ActivityPageDto": {
        "required": [
          "items",
          "nextCursor"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ActivityDto"
            }
          },
          "nextCursor": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ActivityType": {
        "enum": [
          "BoardCreated",
          "MemberAdded",
          "MemberRemoved",
          "MemberRoleChanged",
          "ColumnCreated",
          "ColumnUpdated",
          "TaskCreated",
          "TaskUpdated",
          "TaskMoved",
          "TaskDeleted",
          "CommentAdded"
        ]
      },
      "AuthResponse": {
        "required": [
          "accessToken",
          "expiresAt",
          "user"
        ],
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "user": {
            "$ref": "#/components/schemas/UserDto"
          }
        }
      },
      "BoardDetailDto": {
        "required": [
          "id",
          "name",
          "ownerId",
          "myRole",
          "members",
          "columns",
          "labels"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "ownerId": {
            "type": "integer",
            "format": "int32"
          },
          "myRole": {
            "$ref": "#/components/schemas/BoardRole"
          },
          "members": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MemberDto"
            }
          },
          "columns": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ColumnDto"
            }
          },
          "labels": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LabelDto"
            }
          }
        }
      },
      "BoardNameRequest": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          }
        }
      },
      "BoardRole": {
        "enum": [
          "Viewer",
          "Editor",
          "Owner"
        ]
      },
      "BoardSummaryDto": {
        "required": [
          "id",
          "name",
          "myRole",
          "ownerId",
          "createdAt",
          "cardCount"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "myRole": {
            "$ref": "#/components/schemas/BoardRole"
          },
          "ownerId": {
            "type": "integer",
            "format": "int32"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "cardCount": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "CardDetailDto": {
        "required": [
          "card",
          "comments"
        ],
        "type": "object",
        "properties": {
          "card": {
            "$ref": "#/components/schemas/CardDto"
          },
          "comments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CommentDto"
            }
          }
        }
      },
      "CardDto": {
        "required": [
          "id",
          "boardId",
          "columnId",
          "title",
          "description",
          "position",
          "priority",
          "dueDate",
          "assigneeId",
          "createdById",
          "createdAt",
          "labelIds",
          "commentCount",
          "rowVersion"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "boardId": {
            "type": "integer",
            "format": "int32"
          },
          "columnId": {
            "type": "integer",
            "format": "int32"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          },
          "position": {
            "type": "number",
            "format": "double"
          },
          "priority": {
            "$ref": "#/components/schemas/TaskPriority"
          },
          "dueDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "assigneeId": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "createdById": {
            "type": "integer",
            "format": "int32"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "labelIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            }
          },

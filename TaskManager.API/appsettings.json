{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Key": "",
    "Issuer": "TeamBoard",
    "Audience": "TeamBoard.Web",
    "AccessTokenMinutes": 15
  },
  "Refresh": {
    "Days": 7,
    "CookieName": "teamboard_refresh"
  },
  "RateLimit": {
    "AuthPermitPerMinute": 10
  },
  "ForwardedHeaders": {
    "Enabled": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "AllowedHosts": "*"
}

{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Key": "",
    "Issuer": "TeamBoard",
    "Audience": "TeamBoard.Web",
    "AccessTokenMinutes": 15
  },
  "Refresh": {
    "Days": 7,
    "CookieName": "teamboard_refresh"
  },
  "RateLimit": {
    "AuthPermitPerMinute": 10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
